{
  "name": "czdb",
  "version": "1.0.0",
  "description": "High-performance IP geolocation library for CZDB (纯真IP库) with support for IPv4/IPv6 and dual search modes (Memory/B-tree)",
  "main": "dist/index.cjs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/es/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "build-tsc": "tsc",
    "lint": "eslint src",
    "test": "tsx example/index.ts"
  },
  "keywords": [
    "node",
    "ip",
    "ip2region",
    "czip",
    "czdb",
    "cz"
  ],
  "author": "LIMKIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limkim0530/czdb-search-node"
  },
  "homepage": "https://github.com/limkim0530/czdb-search-node#readme",
  "license": "MIT",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
